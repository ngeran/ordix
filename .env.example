# ============================================================
# Ordix environment variables (development)
# ------------------------------------------------------------
# Copy to .env and fill in. On Cloudflare, AUTH_SECRET is set
# with:  npx wrangler secret put AUTH_SECRET
# ============================================================

# NextAuth v5 secret — generate with: openssl rand -base64 32
AUTH_SECRET=change-me-generate-a-real-secret

# Timezone used for the daily order-number reset (business date).
APP_TIMEZONE=Europe/Athens
