{
  // ============================================================
  // Ordix — Cloudflare Worker configuration (via @opennextjs/cloudflare)
  // ------------------------------------------------------------
  // D1 database "ordix-db" (created 2026-10-11). The binding MUST
  // stay "DB" — the app reads it via getCloudflareContext().env.DB.
  // ============================================================
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ordix",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-03-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ordix-db",
      "database_id": "da1e265f-6dc0-4bc2-9083-646d33d8d87a",
      // Drizzle-generated SQL files live here; applied with:
      //   npm run db:migrate:local   /   npm run db:migrate:remote
      "migrations_dir": "drizzle"
    }
  ]
}
